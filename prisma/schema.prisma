generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum ProjectRole {
  FRONTEND
  BACKEND
  FULLSTACK
}





model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[] 
  experiences   Experience[]

  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}



model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  stack       String[] @default([])
  role        ProjectRole
  client      String?
  project_url String?
  image_url   String[] @default([])
  banner_url  String?
  features    String[] @default([])
  start_date  DateTime?
  end_date    DateTime?
  
 
  isPublished Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  
  admin_id    String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  admin       User     @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@index([created_at])
  @@index([slug])
  @@index([role])
  @@index([isPublished])
  @@map("projects")
}

model Experience {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  images      String[] @default([])
  isPublished Boolean  @default(true)
  admin_id    String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  admin User @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@index([isPublished])
  @@map("experiences")
}

model SiteSettings {
  id              String   @id @default("singleton")
  linkedin_url    String   @default("https://linkedin.com")
  github_url      String   @default("https://github.com")
  email           String   @default("hello@example.com")
  cv_url          String?
  hero_greeting   String   @default("Hi there, Bima Here")
  hero_title      String   @default("Building scalable digital solutions that empower & connect.")
  hero_description String  @db.Text
  about_text      String   @db.Text
  updated_at      DateTime @updatedAt

  @@map("site_settings")
}